# ProductFactory — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
#
# Architecture:
#   PostgreSQL + PM website run in Docker (docker-compose.yml)
#   Orchestrator runs in Docker (productfactory-orchestrator image, started by
#     `docker compose --profile orchestrator up -d`)
#   Agent sessions run in isolated Docker containers (productfactory-agent image)

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=productfactory
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=productfactory
# Used by Alembic (sync psycopg2) and test runner
DATABASE_URL=postgresql://productfactory:CHANGE_ME_STRONG_PASSWORD@localhost:5432/productfactory

# ── PM Website ──────────────────────────────────────────────────────────────
PM_USERNAME=admin
PM_PASSWORD=CHANGE_ME_STRONG_PASSWORD
STUCK_FEATURE_TIMEOUT_HOURS=2      # reset Implementing/Designing/Reviewing features after this many hours
SESSION_LOG_MAXLEN=1000            # max log lines kept in memory per live session

# Required only when running `python scripts/seed.py` — non-trivial passwords.
# Seed refuses common defaults (admin, admin123, password, etc.).
SEED_PM_PASSWORD_DIGVI=CHANGE_ME_STRONG_PASSWORD
SEED_PM_PASSWORD_ALICE=CHANGE_ME_STRONG_PASSWORD

# ── Poller (Windows) ────────────────────────────────────────────────────────
PM_API_URL=http://localhost:8080            # host-side URL (poller → pm-api)
PM_API_URL_CONTAINER=http://pm-api:8080    # container-side URL (agents → pm-api)

# Optional: Slack or Teams webhook for alerts
ALERT_WEBHOOK_URL=

# (Dead env vars removed 2026-05-19: POLL_INTERVAL, LOG_FORMAT, PROMETHEUS_PORT,
# HEARTBEAT_URL, HEARTBEAT_INTERVAL. All were read only by the legacy host-mode
# poller, which was retired in commit 88d8031. The containerized orchestrator
# does not consume any of them.)

SESSION_TIMEOUT_MINUTES=90         # kill agent container after this long
# STALE_THRESHOLD_MINUTES retired 2026-05-28 — old progress.md heartbeat
# (orchestrator/heartbeat.py, deleted). Watchdog handles staleness now.
AUTH_CHECK_TIMEOUT=30              # seconds for claude auth probe
MAX_FEATURES_PER_RUN=1             # default features per agent session (per-product override in DB)
BROWNFIELD_FILE_THRESHOLD=10       # source file count above which a product is auto-detected as brownfield
RECONCILER_CHORES_ENABLED=         # corrective-chore sink — ON by default for all products. Global KILL SWITCH: set 0/false/no/off to disable everywhere. Per-product opt-out: product.config.reconciler_chores=False (Settings -> Workflow checkbox).
BLOCKED_REPROCESSOR_ENABLED=       # wave-8: give Blocked features one auto-retry through the machinery that now handles their class (divergent -> cumulative-checklist retry; code-quality flap/cap -> diagnose-first escalation). Drains the accumulated pool. ON by default for all products. Global KILL SWITCH: set 0/false/no/off to disable everywhere. Per-product opt-out: product.config.blocked_reprocessor=False. One-shot per feature; capped 2/product/cycle; env/spec blocks skipped.

# ── Docker ──────────────────────────────────────────────────────────────────
AGENT_IMAGE=productfactory-agent

# ── Orchestrator container (opt-in, replaces the Windows poller) ──────────
# Enable with `docker compose --profile orchestrator up -d`.
# Runs a deterministic Python loop that calls run_cycle() every 60s to
# launch agent containers. No LLM in the orchestration layer.
#
# PRODUCTS_BASE_DIR=C:/Users/YOU/Personal/ProductFactory  # root of product working dirs
# PRODUCTS_MOUNT_PATH=/products     # container-side path; default is fine
# ORCHESTRATION_CYCLE_SECONDS=60    # tick interval
#
# Staging dir — a host path bind-mounted at /orchestrator-staging.
# The orchestrator writes temp Claude creds here; the Docker daemon mounts
# them into spawned agent containers using the host-side path. MUST be writable.
# ORCHESTRATOR_STAGING_HOST=C:/Users/YOU/.pf-orchestrator-staging

# ── HTTPS (optional, via `docker compose --profile tls up -d`) ───────────────
# Domain name Caddy should serve. Defaults to `localhost` (uses Caddy's
# internal CA — run `docker exec pf-caddy caddy trust` once to install it).
# For a real deployment set this to a real domain — Caddy will auto-obtain a
# Let's Encrypt cert as long as ports 80/443 reach the host from the internet.
CADDY_SITE=localhost

# Windows host paths mounted :ro into agent containers
CLAUDE_DIR=C:/Users/YOU/.claude
SSH_DIR=C:/Users/YOU/.ssh

# ── GitHub ──────────────────────────────────────────────────────────────────
# Optional: increases GitHub API rate limit from 60 to 5000 req/hr
# GITHUB_TOKEN=ghp_...

# ── Local Ollama backend (testing only) ─────────────────────────────────────
# Set AGENT_BACKEND=ollama to use local Ollama instead of the Claude CLI.
# Requires Ollama running on the Windows host with the models pulled:
#   ollama pull qwen3-coder:30b
#
# AGENT_BACKEND=ollama
# OLLAMA_HOST=http://host.docker.internal:11434
# DESIGNER_MODEL=qwen3-coder:30b  # used for designer/reviewer/planner personas
# CODER_MODEL=qwen3-coder:30b     # used for coder persona
# OLLAMA_TIMEOUT=300              # seconds for model inference
# BASH_TIMEOUT=180                # seconds for shell commands in agent
# OLLAMA_RETRY_SLEEP=2            # seconds between Ollama 500 retries
# MAX_TURNS=80                    # hard cap on agentic turns per session

# ── Escalation ladder (wave-5) ────────────────────────────────────────────────
ESCALATION_FIX_ATTEMPTS_THRESHOLD=4   # coder sessions with a feature at/past this run the diagnose-first contract
ESCALATION_MODEL=                     # optional stronger Ollama model for escalated sessions (empty = same model)
ESCALATION_CLAUDE_MODEL=              # optional stronger Claude model for escalated sessions (empty = per-persona default)
