# ProductFactory — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
#
# Architecture:
#   PostgreSQL + PM website run in Docker (docker-compose.yml)
#   Poller runs natively on Windows (deploy/windows/start_poller.ps1)
#   Agent sessions run in isolated Docker containers (productfactory-agent image)

# ── Database ────────────────────────────────────────────────────────────────
# Used by Alembic (run inside the web container on startup)
# Must match POSTGRES_PASSWORD in docker-compose.yml
DATABASE_URL=postgresql://productfactory:CHANGE_ME@localhost:5432/productfactory

# ── PM Website ──────────────────────────────────────────────────────────────
# Must match PM_USERNAME / PM_PASSWORD in docker-compose.yml
PM_USERNAME=admin
PM_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Poller (Windows) ────────────────────────────────────────────────────────
# pm-api container exposes port 8080 to Windows host
PM_API_URL=http://localhost:8080

# Optional: Slack or Teams webhook for alerts
ALERT_WEBHOOK_URL=

POLL_INTERVAL=60                   # seconds between idle polls
SESSION_TIMEOUT_MINUTES=90         # kill agent container after this long
STALE_THRESHOLD_MINUTES=45         # heartbeat: alert if progress.md not pushed in this long

# ── Docker ──────────────────────────────────────────────────────────────────
# Agent image built once by: bash deploy/docker/build.sh
AGENT_IMAGE=productfactory-agent

# Windows host paths mounted :ro into agent containers
CLAUDE_DIR=C:/Users/digvi/.claude
SSH_DIR=C:/Users/digvi/.ssh

# ── GitHub ──────────────────────────────────────────────────────────────────
# Optional: increases GitHub API rate limit from 60 to 5000 req/hr
# GITHUB_TOKEN=ghp_...

# ── Local Ollama backend (testing only) ─────────────────────────────────────
# Set AGENT_BACKEND=ollama to use local Ollama instead of the Claude CLI.
# Requires Ollama running on the Windows host with the models pulled:
#   ollama pull gemma3:27b
#   ollama pull qwen3-coder:30b
#
# AGENT_BACKEND=ollama
# OLLAMA_HOST=http://host.docker.internal:11434
# DESIGNER_MODEL=gemma3:27b       # used for designer + reviewer personas
# CODER_MODEL=qwen3-coder:30b     # used for coder persona
