# Common build artefacts
build/
dist/
out/
*.o
*.a
*.so
*.dll
*.dylib
*.exe

# Framework build/cache dirs (the default stack serves products whose
# stack string didn't match a known template — be generous here. MyCalc1
# 2026-06: a "nextjs" product fell through to this file, which had no
# `.next/` entry, and committed 20MB of webpack caches.)
.next/
.nuxt/
.svelte-kit/
.turbo/
.angular/
.parcel-cache/
*.tsbuildinfo
*.pack.gz

# Common dependency dirs (covers many ecosystems)
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
target/

# Environment
.env
.env.local
.env.*.local

# Test / coverage / cache artefacts (multi-language; covers mixed-stack repos
# where the python or node specific .gitignore isn't shipped because the
# product was discovered as `default`)
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.cache/
*.db
*.sqlite
*.sqlite3

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# ProductFactory session artefacts
session_summary.md
session_result.json
Results/
Temp/
