# Secrets — never commit these
.env
*.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Runtime lock/PID files (poller wrapper + single-instance guard)
orchestrator/poller.pid
orchestrator/wrapper.pid
*.log.[0-9]*
orchestrator/poller.log
orchestrator/poller_boot.log

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Alembic — don't ignore migrations, but ignore pycache inside
db/migrations/__pycache__/

# IDE
.vscode/
.idea/
.claude/

# Claude Code local settings
.claude/

# DB backups — generated by scripts/backup_db.sh
backups/
output/

# Prompt-evals: cached OLD baselines + run-history artifacts written by
# scripts/behavioral_diff.py and scripts/compare_prompt_tokens.py. The
# baseline.txt files are regenerable from `git show HEAD:...` so there's
# nothing here that needs version control.
evals/prompt_baselines/
