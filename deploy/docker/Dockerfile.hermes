# ProductFactory Hermes orchestrator image.
# Runs the Hermes agent (github.com/nousresearch/hermes-agent) as a persistent
# gateway. A 60s cron fires the orchestrate.md skill, which uses the
# productfactory plugin (deploy/hermes/plugins/productfactory) to call the PM
# API and spawn agent containers via the Docker socket mount.

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HERMES_HOME=/home/hermes/.hermes

# -- System deps ---------------------------------------------------------------
# - git, openssh-client: workspace git ops + ssh-keygen for greenfield
# - curl, ca-certificates, gnupg: TLS + apt key for Docker repo
# - Docker CLI only (daemon access via /var/run/docker.sock)
# Hermes agent is installed separately below via the official install script.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl openssh-client ca-certificates gnupg bash sudo xz-utils \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg \
      | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" \
      > /etc/apt/sources.list.d/docker.list \
 && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
 && rm -rf /var/lib/apt/lists/*

# -- Non-root user -------------------------------------------------------------
# GID 998 matches the Docker group GID on most Linux hosts. On Docker Desktop
# for Windows the socket is owned by the "docker" group inside the VM; this
# mapping works for both. Override at runtime with --group-add if needed.
RUN groupadd -g 998 dockerhost \
 && useradd -u 999 -m -s /bin/bash hermes \
 && usermod -aG dockerhost hermes

# -- Hermes agent --------------------------------------------------------------
# Nous Research ships Hermes via a bash installer that sets up a Python venv
# under ~/.local/share/hermes and drops the `hermes` binary in ~/.local/bin.
# The installer is run as the hermes user so everything lives in its HOME.
USER hermes
WORKDIR /home/hermes
# --skip-setup bypasses the interactive setup wizard (which opens /dev/tty and
# breaks in `docker build`). We provide our own ~/.hermes/config.yaml below.
RUN curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh \
      -o /tmp/install-hermes.sh \
 && bash /tmp/install-hermes.sh --skip-setup \
 && rm /tmp/install-hermes.sh

# Installer adds ~/.local/bin to PATH via ~/.bashrc; bake it into the image
# ENV so non-interactive `docker exec` calls and bootstrap.sh pick it up.
ENV PATH=/home/hermes/.local/bin:$PATH \
    PYTHONPATH=/app

USER root

WORKDIR /app

# -- Python deps for the plugin (httpx + existing orchestrator modules) --------
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# -- ProductFactory code (plugin imports orchestrator.docker_runner etc.) ------
COPY orchestrator/ orchestrator/
COPY website/      website/
COPY templates/    templates/

# -- Hermes plugin + skill + config + bootstrap --------------------------------
# /hermes-image-static/ is NOT under the volume mount — it always reflects
# the image's content. bootstrap.sh syncs from here into HERMES_HOME at every
# start, so image rebuilds are picked up on the next container restart.
COPY --chown=hermes:hermes deploy/hermes/config.yaml   /hermes-image-static/config.yaml
COPY --chown=hermes:hermes deploy/hermes/skills/       /hermes-image-static/skills/
COPY --chown=hermes:hermes deploy/hermes/plugins/      /hermes-image-static/plugins/
COPY                       deploy/hermes/bootstrap.sh  /usr/local/bin/bootstrap.sh

RUN chmod +x /usr/local/bin/bootstrap.sh \
 && chown -R hermes:hermes /app

USER hermes
WORKDIR /home/hermes

# Allow git to operate on NTFS/Docker-mounted product dirs (owned by root inside container).
RUN git config --global --add safe.directory '*'

ENTRYPOINT ["/usr/local/bin/bootstrap.sh"]
