# ProductFactory — PM Website Image
# Lightweight Python image for the FastAPI PM website.
# Built by docker-compose, NOT the same as the agent image.
#
# Runs: uvicorn website.main:app

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

# libpq-dev + gcc needed to compile psycopg2-binary on some platforms
# nodejs + npm for Claude CLI (used for OAuth-based LLM calls)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl nodejs npm \
    && npm install -g @anthropic-ai/claude-code \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (cached layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY website/   website/
COPY templates/ templates/
COPY db/        db/
COPY alembic.ini .

# The website needs the GitHub App token minter at
# orchestrator/integrations/github_app.py (PR #9 migration) so the
# dashboard's PR-fetches get an installation token instead of a PAT.
# orchestrator/sprint_pr.py was retired with the 1-PR session-PR model
# (feat/pr-per-session, 2026-05-15) — sprints no longer have their own
# branch/PR, so no provision/merge helpers are needed in the website.
# Bundle only the self-contained leaves; avoid the heavier orchestrator/
# subdirs (docker_runner, supervisor, pipelines) that carry deps the
# website doesn't have.
COPY orchestrator/__init__.py orchestrator/
COPY orchestrator/integrations/__init__.py orchestrator/integrations/github_app.py orchestrator/integrations/
# coder_tiers.py is a pure-stdlib leaf; the admin "Coder Models" save handler
# imports validate_coder_tiers from it (migration 049). Kept as a single source
# of truth with the orchestrator resolver rather than duplicated in website/.
COPY orchestrator/coder_tiers.py orchestrator/

# Run Alembic migrations then start the server.
# startup.sh: self-heals stale alembic_version (tables gone but version row
# exists after a volume wipe), then runs alembic upgrade head + uvicorn.
COPY deploy/docker/startup.sh /startup.sh
RUN chmod +x /startup.sh
CMD ["/startup.sh"]
